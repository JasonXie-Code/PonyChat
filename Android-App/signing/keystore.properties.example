# Copy this file to keystore.properties on every build machine.
# Keep keystore.properties and the .jks file private.
#
# Generate the shared release key once:
# keytool -genkeypair -v -keystore ponychat-release.jks -alias ponychat -keyalg RSA -keysize 2048 -validity 10000
#
# Then copy the same ponychat-release.jks and keystore.properties to:
# Android-App/signing/

storeFile=signing/ponychat-release.jks
storePassword=change-me
keyAlias=ponychat
keyPassword=change-me
