<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内下载 APK 并安装（自更新） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 锁屏时保持 CPU 运行，使 AI 生成可继续（PARTIAL_WAKE_LOCK） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 文件和相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" />
    
    <!-- 地理位置权限（用于向 AI 注入位置/天气信息）-->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 语音识别权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- 🔧 [Android 14+ / 澎湃OS 3] 前台服务麦克风权限 -->
    <!-- 在 Android 14+ 上，使用麦克风的前台服务需要此权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- 🔧 [Android 13+] 音频设备访问 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- 触感反馈：用于原生界面按钮与交互反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 🔔 [后台通知] Android 13+ 需要运行时权限才能发系统通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务：保持 WebSocket（dataSync 类型，Android 14+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 🎮 [聊天陪玩] 屏幕截图服务所需权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 悬浮窗（弹幕叠加层 + 悬浮按钮）：需用户在设置中手动授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 仅同签名的系统级 Companion Runtime 能授予此绑定权限。 -->
    <uses-permission android:name="top.ponychat.companion.permission.BIND_RUNTIME" />
    
    <!-- 相机功能声明（可选，非必须） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <!-- 🎤 [Android 11+] 包可见性声明 - 允许查询语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- 🔧 [澎湃OS] 小爱同学语音助手 -->
        <package android:name="com.miui.voiceassist" />
        <package android:name="com.xiaomi.mibrain.speech" />
        <!-- 🔧 [通用] Google 语音服务 -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.tts" />
        <package android:name="top.ponychat.companion" />
    </queries>

    <application
        android:name=".PonyChatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PonyChatApp"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden|stateAlwaysHidden"
            android:theme="@style/Theme.PonyChatApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 同一 APK 的设备 HOME 入口。普通手机默认禁用；自研系统镜像用 RRO 启用。 -->
        <activity
            android:name=".DeviceHomeActivity"
            android:enabled="@bool/device_home_enabled"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PonyChatApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.chinesechess.ChineseChessActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PonyChatApp" />

        <activity
            android:name=".ui.doudizhu.DoudizhuActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.PonyChatApp" />

        <activity
            android:name=".ui.tictactoe.TicTacToeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PonyChatApp" />
        
        <!-- 🎮 聊天陪玩截图 + 语音输入前台服务
             mediaProjection：截图所需
             microphone：长按语音输入时，用户切换到其他 App 后仍需继续录音（Android 10+ 要求声明此类型） -->
        <service
            android:name=".CompanionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- 保持在线：WebSocket 与消息推送 -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 🤖 操作陪玩无障碍服务：AI 代理模式，执行 tap/swipe 手势操作 -->
        <service
            android:name=".AgentAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
        </service>

        <!-- FileProvider 用于相机拍照 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
