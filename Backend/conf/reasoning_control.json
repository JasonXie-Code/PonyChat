  "drivers": {
    "deepseek_v4": {
      "match": {
        "uses_v4_thinking_api": true,
        "model_name_contains": ["deepseek-v4-flash"],
        "endpoint_contains": ["api.deepseek.com"]
      },
      "disable": {
        "thinking": {
          "type": "disabled"
        },
        "remove": ["reasoning_effort"]
      },
      "enable": {
        "thinking": {
          "type": "enabled"
        },
        "effort_field": "reasoning_effort",
        "supported_depths": ["high", "max"],
        "fallback_depth": "high"
      }
    },
    "doubao_seed": {
      "match": {
        "model_name_contains": ["doubao", "seed"]
      },
      "disable": {
        "thinking": {
          "type": "disabled"
        },
        "remove": ["reasoning_effort"]
      },
      "enable": {
        "thinking": {
          "type": "enabled"
        },
        "effort_field": "reasoning_effort",
        "supported_depths": ["minimal", "low", "medium", "high"],
        "fallback_depth": "high"
      }
    },
    "qwen_enable_thinking": {
      "match": {
        "supports_enable_thinking": true
      },
      "disable": {
        "enable_thinking": false,
        "remove": ["thinking_budget", "reasoning_effort"]
      },
      "enable": {
        "enable_thinking": true,
        "effort_field": "thinking_budget",
        "supported_depths": ["auto", "low", "medium", "high"],
        "fallback_depth": "high"
      }
    },
    "grok_3_mini": {
      "match": {
        "model_name_contains": ["grok-3-mini"]
      },
      "disable": {
        "remove": ["reasoning_effort"]
      },
      "enable": {
        "effort_field": "reasoning_effort",
        "supported_depths": ["low", "high"],
        "fallback_depth": "high"
      }
    },
    "generic_reasoning_effort": {
      "match": {
        "default": true
      },
      "disable": {
        "remove": ["reasoning_effort", "reasoning"]
      },
      "enable": {
        "effort_field": "reasoning_effort",
        "supported_depths": ["minimal", "low", "medium", "high"],
        "fallback_depth": "high"
      }
    }
