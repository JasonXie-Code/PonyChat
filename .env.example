# PonyChat environment template.
# Copy to .env locally or inject equivalent variables in systemd/deployment.
# Never commit real secrets.

# Auth / app
AUTH_SECRET=
PONYCHAT_APP_VERSION_NAME=5.6.13
PONYCHAT_APP_VERSION_CODE=353
PONYCHAT_APP_DOWNLOAD_URL=https://ponychat.org/download/apk

# Database / runtime paths
PONYCHAT_DB_PATH=
PONYCHAT_BACKUP_DIR=
PONYCHAT_MLP_VECTOR_DB_PATH=

# Core model providers
PONYCHAT_DEEPSEEK_API_KEY=
PONYCHAT_DEEPSEEK_CODE_API_KEY=
PONYCHAT_DOUBAO_API_KEY=
PONYCHAT_DASHSCOPE_API_KEY=
PONYCHAT_APIYI_API_KEY=
PONYCHAT_OPENROUTER_API_KEY=
PONYCHAT_POLOAI_API_KEY=
PONYCHAT_XAI_API_KEY=

# Voice
PONYCHAT_VOICE_ENABLED=1
PONYCHAT_VOICE_LAB_ENABLED=1
PONYCHAT_TTS_PROVIDER=cosyvoice
PONYCHAT_COSYVOICE_BASE_URL=https://voice.ponychat.org/cosyvoice
COSYVOICE_MODEL=cosyvoice-v3.5-plus
COSYVOICE_DEFAULT_VOICE=longanyang
PONYCHAT_VOICE_LAB_DEFAULT_VARIANT=original

# Legacy ASR/TTS realtime endpoints
PONYCHAT_ALIYUN_ACCESS_KEY_ID=
PONYCHAT_ALIYUN_ACCESS_KEY_SECRET=
PONYCHAT_ALIYUN_NLS_APP_KEY=
PONYCHAT_ALIYUN_NLS_TTS_VOICE=
PONYCHAT_DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
PONYCHAT_DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
PONYCHAT_DASHSCOPE_TTS_VOICE=Cherry

# Optional Drive
PONYCHAT_DRIVE_PASSWORD=
PONYCHAT_DRIVE_TOKEN_TTL_SECONDS=604800

